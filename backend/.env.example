# 复制为 backend/.env 并按需修改（.env 已被 git 忽略）。
# 数据库需手动执行 schema.sql 初始化；应用启动不会建表或改表。

# 首次启动时用于创建唯一账号。账号创建后这两项可以删掉，不会覆盖已有账号。
EASY_KANBAN_USERNAME=manager
EASY_KANBAN_PASSWORD=change-me-please

# 必填：登录 token 的签名密钥。用下面的命令生成一个：
#   python -c "import secrets; print(secrets.token_hex(32))"
EASY_KANBAN_SECRET_KEY=

# 可选：SQLite 文件路径，默认 backend/data/easy-kanban.db
# EASY_KANBAN_DB=/srv/easy-kanban/data/easy-kanban.db

# 可选：监听地址与端口。默认只监听本机，由 Nginx 反向代理对外提供服务。
# EASY_KANBAN_HOST=127.0.0.1
# EASY_KANBAN_PORT=5003

# 可选：设为 1 时打开 Flask 调试模式（会输出详细错误并自动重载，生产环境不要开）
# EASY_KANBAN_DEBUG=0
